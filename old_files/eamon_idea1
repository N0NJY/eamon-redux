from core.engine import Engine  # or whatever context you pass

HANDLERS: Dict[str, Callable] = {}

@HANDLERS.setdefault("start")
def on_game_start(engine: Engine):
    """Runs once at adventure start (setup flags, initial positions, etc.)"""
    engine.game_data["trollsfires_activated"] = False
    # Move monsters, reveal things, etc.

@HANDLERS.setdefault("read")
def on_read(engine: Engine, artifact):
    """Custom READ handling"""
    if artifact.id == 42:  # the dangerous book
